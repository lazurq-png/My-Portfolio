---
export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
}

const DEFAULT_TITLE = "Martin Larsson — Software Developer";
const DEFAULT_DESCRIPTION =
  "Portfolio website for Martin Larsson, a software developer working across systems, web, and modern tooling.";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  ogType = "website",
} = Astro.props;

// TODO: set `site` in astro.config.mjs to the deployed domain so canonical/og:url
// become absolute URLs. Until then these stay root-relative, which is valid HTML
// (resolved against the document URL) but weaker for crawlers.
const canonical = Astro.site
  ? new URL(canonicalPath, Astro.site).href
  : canonicalPath;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Blocking, and placed above the stylesheets a classic script would otherwise
         wait on, so the stored theme is applied before anything paints. -->
    <script is:inline src="/theme-init.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-shell">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d10;
    --ink: #edeae3;
    --ink-dim: #868c97;
    --accent: #e8a33d;
    --rule: #1d2026;
  }

  :root[data-theme="light"] {
    --bg: #f7f5f0;
    --ink: #1b1d21;
    --ink-dim: #5b616c;
    --accent: #9c5c17;
    --rule: #dcd7cc;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: "Manrope", sans-serif;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .app-shell {
    display: flex;
    flex-direction: column;
    max-width: 72rem;
    margin: 0 auto;
    padding-bottom: 3rem;
  }

  a {
    color: inherit;
  }
  .post-date {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
  }
  .page-shell {
    max-width: 72rem;
    margin: 0 auto;
    padding-bottom: 3rem;
  }

  .hero {
    margin-bottom: 2rem;
  }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-family: "IBM Plex Mono", monospace;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    margin: 0 0 0.75rem;
    color: var(--ink);
  }

  .intro {
    color: var(--ink-dim);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 42rem;
    margin: 0;
  }

  .post-list {
    display: grid;
    gap: 1rem;
  }

  .post-card {
    border: 1px solid var(--rule);
    border-radius: 1rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .post-card h2 {
    margin: 0 0 0.65rem;
    color: var(--ink);
    font-size: 1.1rem;
  }

  .post-card p {
    margin: 0;
    color: var(--ink-dim);
    line-height: 1.6;
  }

  @media (min-width: 300px) {
    .page-shell,
    .app-shell {
      padding-right: 1rem;
      padding-left: 1rem;
      text-align: left;
    }
    /* Changes layout to a horizontal row on tablets */
    .stats-grid {
      flex-direction: row;
    }
  }

  @media (min-width: 768px) {
    .app-shell {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .page-shell,
    .app-shell {
      padding: 1.1rem 1rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }
  }
</style>
