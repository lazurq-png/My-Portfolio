---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import { Icon } from "astro-icon/components";

const name = "Martin Larsson";
const role = "Software Engineer";
const status = "Currently building things with Astro + Next.js";

const bio = `I am a Swedish software developer with a bachelor's in Computer Science.
My experience spans a wide range of technologies, of which some are shown by the icons at the bottom of this page.
I enjoy creating simple but efficient software solutions,and I like exploring new programming languages, technologies and frameworks.
In my free time, I spend most of my time listening to audiobooks or playing video games with my friends.
But anything considered "nerdy" is usually something I would at least be interested in trying out.`;
---

<Layout>
  <SiteNav />
  <main class="home-shell">
    <section class="hero-card">
      <p class="eyebrow">Me, myself and I</p>
      <h1>{name}</h1>
      <p class="role">{role}</p>
      <p class="bio">{bio}</p>
      <p class="status"><span class="dot"></span>{status}</p>
    </section>

    <section class="info-card" aria-label="Technology stack">
      <p class="built-with">Languages/Skills</p>
      <Icon name="devicon:c" class="badge" />
      <Icon name="devicon:csharp" class="badge" />
      <Icon name="devicon:cplusplus" class="badge" />
      <Icon name="devicon:javascript" class="badge" />
      <Icon name="devicon:typescript" class="badge" />
      <Icon name="devicon:python" class="badge" />
      <Icon name="devicon:astro" class="badge-dark" />
      <Icon name="devicon:nextjs" class="badge-dark" />
      <Icon name="devicon:css" class="badge" />
    </section>
  </main>
</Layout>

<style>
  .home-shell {
    display: grid;
    gap: 1rem;
  }

  .hero-card,
  .info-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--rule);
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    margin: 0 0 0.4rem;
    color: var(--ink);
  }

  .role {
    font-size: 1.05rem;
    color: var(--ink-dim);
    margin: 0 0 1.25rem;
  }

  .bio {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink);
    margin: 0 0 1.25rem;
    max-width: 40rem;
    white-space: pre-line;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    color: var(--ink-dim);
    margin: 0 0 1.3rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .primary-link,
  .secondary-link {
    text-decoration: none;
    padding: 0.7rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .primary-link {
    background: var(--accent);
    color: #111;
    font-weight: 600;
  }

  .secondary-link {
    color: var(--ink);
  }

  .primary-link:hover,
  .secondary-link:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }

  .built-with {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 0 0 0.9rem;
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .badge {
    width: 48px;
    height: 48px;
  }
  .badge-dark {
    width: 48px;
    height: 48px;
    background: #d8dae0;
  }
</style>
