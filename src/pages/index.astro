---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import { Icon } from "astro-icon/components";

const name = "Martin Larsson";
const role = "Software Engineer";
const status = "Currently building things with Astro + Next.js";

// Real paragraphs rather than one string with hard newlines: a fixed line break
// that reads fine on a laptop turns into a ragged half-empty row on a phone.
const bio = [
  `I am a Swedish software developer with a bachelor's in Computer Science. My
   experience spans a wide range of technologies, of which some are shown by the
   icons at the bottom of this page.`,
  `I enjoy creating simple but efficient software solutions, and I like exploring
   new programming languages, technologies and frameworks.`,
  `In my free time, I spend most of my time listening to audiobooks or playing
   video games with my friends. But anything considered "nerdy" is usually
   something I would at least be interested in trying out.`,
];

const skills = [
  { name: "devicon:c", label: "C" },
  { name: "devicon:csharp", label: "C#" },
  { name: "devicon:cplusplus", label: "C++" },
  { name: "devicon:javascript", label: "JavaScript" },
  { name: "devicon:typescript", label: "TypeScript" },
  { name: "devicon:python", label: "Python" },
  { name: "devicon:astro", label: "Astro", plate: true },
  { name: "devicon:nextjs", label: "Next.js", plate: true },
  { name: "devicon:css", label: "CSS" },
];
---

<Layout>
  <SiteNav />
  <main class="page-shell">
    <section class="hero-card">
      <p class="eyebrow">/home</p>
      <h1>{name}</h1>
      <p class="role">{role}</p>
      <div class="bio">
        {bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="status"><span class="dot"></span>{status}</p>
    </section>

    <section class="info-card" aria-label="Technology stack">
      <p class="section-label">Languages / Skills</p>
      <ul class="stack" role="list">
        {
          skills.map((skill) => (
            <li class="stack-item">
              <Icon
                name={skill.name}
                class={skill.plate ? "badge badge-plate" : "badge"}
                title={skill.label}
              />
              <span class="stack-label">{skill.label}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  .hero-card,
  .info-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-m);
  }

  .role {
    font-size: var(--step-1);
    color: var(--ink-dim);
    margin: var(--space-3xs) 0 var(--space-m);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    /* Same measure as .intro and the article body, so the row length is
       consistent from page to page. */
    max-width: var(--measure);
    margin-bottom: var(--space-m);
  }

  .bio p {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.75;
    color: var(--ink);
  }

  .status {
    display: flex;
    /* The status can wrap to two lines on a phone; centring would float the
       dot into the gap between them. */
    align-items: baseline;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-dim);
    margin: 0;
  }

  .dot {
    width: 6px;
    height: 6px;
    transform: translateY(-0.1em);
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 0 0 var(--space-m);
  }

  /* auto-fill rather than a fixed count: the row reflows from three icons on a
     360px screen up to the full set, with no breakpoint of its own. */
  .stack {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    text-align: center;
  }

  .badge {
    width: 2.25rem;
    height: 2.25rem;
  }

  /* Astro and Next.js ship as monochrome marks that vanish on a dark ground,
     so they get a neutral plate instead of a hard-coded light swatch. */
  .badge-plate {
    box-sizing: content-box;
    padding: 0.3rem;
    border-radius: var(--radius-s);
    background: #e6e8ec;
    color: #14161a;
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }
</style>
