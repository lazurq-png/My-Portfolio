---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";

const projects = [
  {
    title: "Portfolio Site",
    summary:
      "A polished Astro-based portfolio experience with a lightweight, modern presentation.",
    stack: ["Astro", "TypeScript", "CSS"],
    link: "https://github.com/lazurq-png/My-Portfolio",
  },
  {
    title: "Next.js Dashboard Template",
    summary:
      "Learning how to use Next.js to build interactive web applications.",
    stack: ["Next.js", "React", "TypeScript", "PostgreSQL"],
    link: "https://github.com/lazurq-png/next.js-dashboard",
  },
];
---

<Layout>
  <SiteNav />
  <main class="page-shell">
    <section class="hero">
      <p class="eyebrow">/projects</p>
      <h1>Selected work</h1>
      <p class="intro">Template for showcasing my projects.</p>
    </section>

    <section class="project-grid" aria-label="Project list">
      {
        projects.map((project) => (
          <a
            class="card-link"
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <article class="post-card card">
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              <ul class="tags" role="list">
                {project.stack.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </article>
          </a>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  /* Single column on a phone; only splits once there is genuinely room for
     two readable cards side by side. */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
  }

  /* Local to this grid on purpose: it is about when two cards stop being
     cramped, not about the nav rail, so it is not the shared 48rem
     breakpoint and does not need to move with it. */
  @media (min-width: 34rem) {
    .project-grid {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin: var(--space-s) 0 0;
  }

  .tags li {
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
