---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    // Sanitize slug: remove directory traversal characters and non-URL-safe characters
    const slug = post.id.replace(/\.(md|mdx)$/i, "")
      .replace(/[^a-zA-Z0-9\-_]/g, "-")
      .replace(/-+/g, "-")
      // Remove leading and trailing dashes
      .replace(/^-+|-+$/g, "");
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Your Name`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <SiteNav />
  <a style={`text-decoration: none;`} href="/blog">
    <img src="/arrowdark.ico" />
  </a>
  <main class="content-shell">
    <div
      class="article-layout"
      style="max-width: var(--max); padding-inline: 1.25rem;"
    >
      <article class="article-shell" data-pagefind-body>
        <p class="post-date">
          <time datetime={post.data.pubDate.toISOString()}>
            {
              post.data.pubDate.toLocaleDateString("en-GB", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </p>
        <h1 class="article-title">{post.data.title}</h1>
        <div class="article-prose">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>
<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .article-prose {
    font-size: 1.1rem;
    line-height: 1.25;
    margin: 0 0 1.25rem;
    white-space: pre-line;
    font-family: "Inter", sans-serif;
  }
  .article-title {
    font-size: 2rem;
    font-weight: 1000;
    font-family: "Inter", sans-serif;
  }
  .article-shell {
    max-width: var(--max);
    margin: 0 auto;
  }
  .content-shell {
    max-width: var(--max);
    margin: 0 auto;
    padding-bottom: 3rem;
  }
</style>
