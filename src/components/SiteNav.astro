---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home", subtitle: "Me, myself and I" },
  { href: "/projects/", label: "My Projects", subtitle: "Code/Tech" },
  { href: "/blog/", label: "Blog", subtitle: "Notes" },
];

// LinkedIn template: set this to the profile URL and the icon renders itself
// next to GitHub, in both the mobile panel and the desktop rail. Nothing else
// needs changing -- the markup and styling below are already in place.
const linkedinUrl = "";
---

<header class="site-header" id="site-header" data-open="false">
  <nav class="site-nav" aria-label="Primary">
    <div class="nav-bar">
      <a class="brand" href="/">Martin</a>

      {/* Hamburger: only rendered visible below 48rem, see the media query. */}
      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-menu"
        aria-label="Open menu"
      >
        <svg
          class="icon-open"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="icon-close"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div id="main-menu" class="nav-panel">
      <ul class="nav-links" role="list">
        {
          links.map((link) => {
            const isActive =
              link.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(link.href);
            return (
              <li>
                <a href={link.href} aria-current={isActive ? "page" : undefined}>
                  <span class="nav-label">{link.label}</span>
                  <span class="nav-subtitle" aria-hidden="true">
                    {link.subtitle}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="nav-footer">
        <a
          class="icon-btn"
          href="https://github.com/lazurq-png/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
        >
          <svg
            viewBox="0 0 16 16"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                 -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                 .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                 -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09
                 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15
                 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2
                 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>

        {
          linkedinUrl && (
            <a
              class="icon-btn"
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profile"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.71h.05A4.17 4.17 0 0 1 17.6 8.7c3.6 0 4.4 2.3 4.4 5.34V21h-4v-5.98c0-1.43-.03-3.27-2.05-3.27-2.05 0-2.37 1.56-2.37 3.17V21H10V9Z" />
              </svg>
            </a>
          )
        }

        <button
          id="theme-toggle"
          class="icon-btn"
          type="button"
          aria-label="Toggle color theme"
          aria-pressed="false"
        >
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="icon-moon"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Same reasoning as theme-init.js: a real same-origin file, so it satisfies
     the `script-src 'self'` CSP without an inline hash. -->
<script is:inline src="/nav.js" defer></script>

<!-- Without JS the panel can never be opened, so show it and drop the control.
     Unscoped on purpose: Astro does not add its scope hash inside <noscript>,
     and this sits after the component styles so it wins on order. -->
<noscript>
  <style>
    .nav-panel {
      display: block !important;
    }
    .nav-toggle {
      display: none !important;
    }
  </style>
</noscript>

<style>
  /* ---------------------------------------------------------------- *
   * Mobile first: a sticky top bar, with the links, the theme toggle
   * and the social icons collapsed behind the hamburger.
   * ---------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Cancel .app-shell's gutter so the bar and its rule run edge to edge,
       while the content inside stays on the same gutter as the page. */
    margin-inline: calc(var(--gutter) * -1);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.5rem;
    padding-inline: var(--gutter);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px: the minimum comfortable touch target. */
    width: 44px;
    height: 44px;
    margin-right: calc(var(--space-2xs) * -1);
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .nav-toggle:hover {
    border-color: var(--rule);
    background: var(--surface);
  }

  .nav-toggle .icon-close,
  .site-header[data-open="true"] .nav-toggle .icon-open {
    display: none;
  }

  .site-header[data-open="true"] .nav-toggle .icon-close {
    display: block;
  }

  .nav-panel {
    display: none;
    padding: var(--space-2xs) var(--gutter) var(--space-s);
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }

  .site-header[data-open="true"] .nav-panel {
    display: block;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    min-height: 44px;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-s);
    text-decoration: none;
    color: var(--ink);
  }

  .nav-label {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .nav-subtitle {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background: var(--accent);
    color: var(--on-accent);
  }

  .nav-links a:hover .nav-subtitle,
  .nav-links a:focus-visible .nav-subtitle {
    color: var(--on-accent);
  }

  .nav-links a[aria-current="page"] {
    background: var(--accent-soft);
  }

  .nav-links a[aria-current="page"] .nav-label {
    color: var(--accent);
  }

  .nav-links a[aria-current="page"]:hover,
  .nav-links a[aria-current="page"]:focus-visible {
    background: var(--accent);
  }

  .nav-links a[aria-current="page"]:hover .nav-label,
  .nav-links a[aria-current="page"]:focus-visible .nav-label {
    color: var(--on-accent);
  }

  .nav-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink-dim);
    cursor: pointer;
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    color: var(--accent);
    background: var(--accent-soft);
  }

  html:not([data-theme="light"]) .icon-moon {
    display: none;
  }

  html[data-theme="light"] .icon-sun {
    display: none;
  }

  /* ---------------------------------------------------------------- *
   * >=48rem: the bar becomes the left rail. The hamburger goes away
   * and the panel is permanently open.
   *
   * Same breakpoint as .app-shell in Layout.astro and the matchMedia()
   * in public/nav.js -- see the note by the tokens there before changing
   * it, and change all three.
   * ---------------------------------------------------------------- */
  @media (min-width: 48rem) {
    .site-header {
      position: sticky;
      /* Matches .app-shell's top padding, so the rail lines up with the
         first line of the page content. */
      top: var(--space-l);
      z-index: auto;
      flex: 0 0 var(--sidebar);
      align-self: flex-start;
      display: flex;
      flex-direction: column;
      margin-inline: 0;
      padding: var(--space-m) var(--space-2xs);
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }

    .nav-bar {
      min-height: 0;
      margin-bottom: var(--space-m);
      padding-inline: var(--space-xs);
    }

    .nav-toggle {
      display: none;
    }

    .nav-panel {
      display: block;
      padding: 0;
      border-top: 0;
      background: transparent;
    }

    .nav-links a {
      padding: var(--space-2xs) var(--space-xs);
      min-height: 0;
    }

    .nav-footer {
      margin-top: var(--space-m);
      padding-top: var(--space-s);
    }

    .icon-btn {
      width: 40px;
      height: 40px;
    }
  }
</style>
