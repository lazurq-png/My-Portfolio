---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home", subtitle: "Me, myself and I" },
  { href: "/projects/", label: "My Projects", subtitle: "Code/Tech" },
  { href: "/blog/", label: "Blog", subtitle: "Notes" },
];
---

<header>
  <nav class="site-nav" aria-label="Primary">
    <a class="brand" href="/">Martin</a>
    <div id="main-menu" class="nav-links">
      {
        links.map((link) => {
          const isActive =
            link.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(link.href);
          return (
            <a href={link.href} aria-current={isActive ? "page" : undefined}>
              <span class="nav-label">{link.label}</span>
              <span class="nav-subtitle" aria-hidden="true">
                {link.subtitle}
              </span>
            </a>
          );
        })
      }
    </div>
    <div class="nav-footer">
      <a
        class="icon-btn"
        href="https://github.com/lazurq-png/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
      >
        <svg
          viewBox="0 0 16 16"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                   0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                   -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                   .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                   -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09
                   2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15
                   0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2
                   0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Toggle color theme"
        aria-pressed="false"
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .brand,
  .nav-footer {
    display: none;
  }

  .nav-subtitle {
    display: none;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    text-decoration: none;
    font-weight: bold;
    color: var(--ink);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background-color: var(--accent);
    color: var(--bg);
  }

  .nav-links a[aria-current="page"] .nav-label {
    color: var(--accent);
  }

  .nav-links a[aria-current="page"]:hover .nav-label,
  .nav-links a[aria-current="page"]:focus-visible .nav-label {
    color: var(--bg);
  }

  html:not([data-theme="light"]) .icon-moon {
    display: none;
  }

  html[data-theme="light"] .icon-sun {
    display: none;
  }

  @media (min-width: 768px) {
    header {
      flex: 0 0 220px;
      position: sticky;
      top: 1.5rem;
      align-self: flex-start;
    }

    .site-nav {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      border: 1px solid var(--rule);
      border-radius: 1.25rem;
      background: rgba(255, 255, 255, 0.03);
      padding: 1.5rem 1rem;
    }

    .brand {
      display: block;
      font-weight: 700;
      text-decoration: none;
      color: var(--ink);
      font-family: "IBM Plex Mono", monospace;
      padding: 0 0.75rem;
    }

    .nav-links {
      flex-direction: column;
      width: auto;
      gap: 0.25rem;
    }

    .nav-links a {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      display: flex;
      padding: 0.6rem 0.75rem;
      min-height: auto;
      border-radius: 0.6rem;
    }

    .nav-subtitle {
      display: block;
      font-size: 0.6rem;
      font-weight: normal;
      letter-spacing: 0.08em;
      color: var(--ink-dim);
    }

    .nav-links a:hover .nav-subtitle,
    .nav-links a:focus-visible .nav-subtitle {
      color: var(--bg);
    }

    .nav-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 1rem;
      border-top: 1px solid var(--rule);
    }

    .icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 0.6rem;
      color: var(--ink-dim);
      background: transparent;
      border: none;
      cursor: pointer;
    }

    .icon-btn:hover,
    .icon-btn:focus-visible {
      color: var(--accent);
      background: rgba(232, 163, 61, 0.12);
    }
  }
</style>
