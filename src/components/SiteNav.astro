---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "My Projects" },
  { href: "/blog/", label: "Blog" },
];
---

<header>
  <nav class="site-nav" aria-label="Primary">
    <div id="main-menu" class="nav-links">
      {
        links.map((link) => {
          const isActive =
            link.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(link.href);
          return (
            <a href={link.href} aria-current={isActive ? "page" : undefined}>
              {link.label}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>

<style>
  .nav-links {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    text-decoration: none;
    font-weight: bold;
    color: var(--ink);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background-color: var(--accent);
    color: var(--bg);
  }

  .nav-links a[aria-current="page"] {
    color: var(--accent);
  }

  .nav-links a[aria-current="page"]:hover,
  .nav-links a[aria-current="page"]:focus-visible {
    color: var(--bg);
  }

  @media (min-width: 768px) {
    .nav-links {
      flex-direction: row;
      justify-content: flex-start;
      margin-left: 5em;
      width: auto;
    }

    .nav-links a {
      display: inline-flex;
      padding: 10px 10px;
      min-height: auto;
    }
  }
</style>
