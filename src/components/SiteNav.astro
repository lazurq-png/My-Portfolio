---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "My Projects" },
  { href: "/blog", label: "Blog" },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-nav" aria-label="Primary">
  <a class="brand" href="/">Martin Larsson</a>
  <div class="nav-links">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["nav-link", { active: currentPath === link.href }]}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0 1.75rem;
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .nav-link {
    text-decoration: none;
    color: var(--ink-dim);
    font-size: 0.95rem;
    transition: color 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
  }
</style>
