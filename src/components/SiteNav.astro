---
const currentPath = Astro.url.pathname;
---

<header>
  <nav class="site-nav" aria-label="Primary">
    <div id="main-menu" class="nav-links">
      <a style={`text-decoration: none;`} href="/">Home</a>
      <a style={`text-decoration: none;`} href="/projects/">My Projects</a>
      <a style={`text-decoration: none;`} href="/blog/">Blog</a>
    </div>
  </nav>
</header>

<style>
  .nav-links {
    width: 100%;
    margin: 0;
  }

  .nav-links a {
    display: block;
    text-align: center;
    text-decoration: none;
    font-weight: bold;
    color: #ececf1;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    background-color: #e8813d;
  }

  @media screen and (min-width: 768px) {
    .nav-links {
      margin-left: 5em;
      display: block;
      position: static;
      width: auto;
      background: none;
    }

    .nav-links a {
      display: inline-block;
      padding: 10px 10px;
    }
  }
</style>
