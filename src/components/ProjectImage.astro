---
/**
 * A project's picture: the image in src/assets/projects/ named after the repo
 * (see src/lib/projectImages.ts for the naming rule). Shared by the project card
 * and its preview dialog so the two cannot disagree about which image a project
 * has.
 *
 * Self-hosted on purpose (ADR 0018). The pictures used to be hot-linked from
 * GitHub's Open Graph host, which rate-limits per IP and answered 429 often
 * enough to leave broken-image icons in the cards. A project with no file renders
 * nothing here and the caller's reserved 2:1 box stays as a plain panel --
 * `projects.test.ts` fails if a curated project has no file, so that is a
 * fallback and not a state the site is meant to be in.
 *
 * Always 2:1, the box both callers reserve. Decorative (`alt=""`): the project
 * title sits right next to it in both.
 */
import { Image } from "astro:assets";

import { projectImage } from "../lib/projectImages";

interface Props {
  /** `owner/name`. */
  repo: string;
  /** Rendered width in px; height follows at 2:1. */
  width: number;
}

const { repo, width } = Astro.props;
const local = projectImage(repo);
const height = width / 2;
---

{local && (
  <Image src={local} alt="" width={width} height={height} loading="lazy" decoding="async" />
)}
