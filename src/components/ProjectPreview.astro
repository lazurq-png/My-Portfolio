---
/**
 * The preview widget behind a project card: a native <dialog>, pre-rendered.
 *
 * Everything here is baked in at build time by the `projects` loader. It has to
 * be: github.com serves `X-Frame-Options: deny` so it cannot be framed, and the
 * site CSP's `connect-src 'self'` means the browser cannot call the GitHub API
 * either. The only third-party request this makes at runtime is the social
 * image, which `img-src 'self' https:` already allows -- adding anything else
 * external means updating SECURITY_HEADERS in src/lib/headers.ts.
 *
 * <dialog>.showModal() supplies the focus trap, the Escape handler, the
 * backdrop and inertness of the page behind it. public/projects.js only opens
 * it; none of that is reimplemented.
 */
import type { CollectionEntry } from "astro:content";

import { socialImageUrl } from "../lib/github";
import { sanitizeSlug } from "../lib/sanitize";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { repo, title, summary, stack, link, language, topics, stars, pushedAt } =
  project.data;

// sanitizeSlug turns `owner/name` into a DOM-safe `owner-name`. Reused rather
// than rewritten so there is still one set of slug rules in the codebase.
const slug = sanitizeSlug(project.id);
const dialogId = `preview-${slug}`;
const headingId = `${dialogId}-title`;

const updated = pushedAt?.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// A project whose fetch failed has none of these, and shows no stats row at all
// rather than a row of blanks.
const stats = [
  language ? { label: "Language", value: language } : null,
  stars === undefined ? null : { label: "Stars", value: String(stars) },
  updated ? { label: "Updated", value: updated } : null,
].filter((stat) => stat !== null);
---

<dialog id={dialogId} class="preview" aria-labelledby={headingId}>
  {/* Inner wrapper: a click landing on the <dialog> itself is a backdrop
      click, which is how public/projects.js tells the two apart. */}
  <div class="preview__body">
    <div class="preview__media">
      <img
        src={socialImageUrl(repo)}
        alt=""
        width="1280"
        height="640"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="preview__content">
      <h2 id={headingId}>{title}</h2>
      <p class="preview__summary">{summary}</p>

      <ul class="tags" role="list">
        {stack.map((tag) => <li>{tag}</li>)}
      </ul>

      {
        stats.length > 0 && (
          <dl class="preview__stats">
            {stats.map((stat) => (
              <div class="preview__stat">
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        topics.length > 0 && (
          <ul class="tags tags--muted" role="list" aria-label="GitHub topics">
            {topics.slice(0, 6).map((topic) => (
              <li>{topic}</li>
            ))}
          </ul>
        )
      }

      <footer class="preview__actions">
        <a
          class="preview__link"
          href={link}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub &rarr;
        </a>
        {/* method="dialog" closes the dialog with no JavaScript at all, so the
            widget is never a trap once it is open. */}
        <form method="dialog">
          <button type="submit" class="preview__close">Close</button>
        </form>
      </footer>
    </div>
  </div>
</dialog>

<style>
  /* All surfaces, spacing and radii come from the tokens in Layout.astro --
     nothing here hard-codes a colour, so the dialog follows the theme toggle. */
  .preview {
    width: min(38rem, 92vw);
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
  }

  .preview::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  /* Reserved before the image arrives: the dialog is display:none until it is
     opened, so the image starts loading only on first open and the box is what
     stops the content below it jumping when it lands. */
  .preview__media {
    aspect-ratio: 2 / 1;
    background: var(--surface-strong);
    border-block-end: 1px solid var(--rule);
  }

  .preview__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
  }

  .preview h2 {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 600;
  }

  .preview__summary {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-dim);
    line-height: 1.6;
  }

  .preview__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin: 0;
  }

  .preview__stat dt {
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .preview__stat dd {
    margin: 0;
    font-weight: 600;
  }

  .preview__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    padding-block-start: var(--space-2xs);
  }

  .preview__link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    text-decoration: none;
  }

  .preview__link:hover {
    text-decoration: underline;
  }

  .preview__close {
    margin-inline-start: auto;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .preview__close:hover {
    border-color: var(--accent);
  }
</style>
